{
  "schemaVersion": "1.0",
  "project": "novatech-assistant",
  "mcpServers": {
    "mcp-github": {
      "name": "mcp-github",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_OWNER": "${GITHUB_OWNER}",
        "GITHUB_REPO": "${GITHUB_REPO}",
        "GITHUB_ALLOWED_REPOS": "${GITHUB_OWNER}/${GITHUB_REPO}",
        "GITHUB_BLOCK_DIRECT_PUSH": "true",
        "GITHUB_BLOCK_MAIN_BRANCHES": "main,develop",
        "GITHUB_ALLOW_ISSUES_WRITE": "true",
        "GITHUB_ALLOW_PRS_WRITE": "true",
        "GITHUB_ALLOW_REPO_SETTINGS_WRITE": "false",
        "GITHUB_ALLOW_SECRETS_ACCESS": "false"
      },
      "enabled": false,
      "status": "validar",
      "notes": "Validar substituto mantido do server GitHub arquivado upstream; restringir ao repo ${GITHUB_OWNER}/${GITHUB_REPO}; sem push direto em main/develop."
    },
    "mcp-azure-ai-search": {
      "name": "mcp-azure-ai-search",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp-azure-ai-search/index.js"
      ],
      "env": {
        "AZURE_SEARCH_ENDPOINT": "${AZURE_SEARCH_ENDPOINT}",
        "AZURE_SEARCH_INDEX": "${AZURE_SEARCH_INDEX}",
        "AZURE_SEARCH_ALLOWED_INDEXES": "${AZURE_SEARCH_INDEX}",
        "AZURE_SEARCH_AUTH_MODE": "${AZURE_SEARCH_AUTH_MODE}",
        "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
        "AZURE_TENANT_ID": "${AZURE_TENANT_ID}",
        "AZURE_SEARCH_API_KEY": "${AZURE_SEARCH_API_KEY}",
        "AZURE_SEARCH_ALLOW_INDEX_MUTATION": "false",
        "AZURE_SEARCH_ALLOW_DELETE": "false",
        "AZURE_SEARCH_ALLOWED_OPERATIONS": "search,get,suggest"
      },
      "enabled": false,
      "status": "construir",
      "notes": "Server custom pendente; aplicar role Search Index Data Reader e limitar ao indice ${AZURE_SEARCH_INDEX}; proibido indexar/deletar."
    },
    "mcp-azure-openai": {
      "name": "mcp-azure-openai",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp-azure-openai/index.js"
      ],
      "env": {
        "AZURE_OPENAI_ENDPOINT": "${AZURE_OPENAI_ENDPOINT}",
        "AZURE_OPENAI_API_VERSION": "${AZURE_OPENAI_API_VERSION}",
        "AZURE_OPENAI_CHAT_DEPLOYMENT": "${AZURE_OPENAI_CHAT_DEPLOYMENT}",
        "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "${AZURE_OPENAI_EMBEDDING_DEPLOYMENT}",
        "AZURE_OPENAI_ALLOWED_DEPLOYMENTS": "${AZURE_OPENAI_CHAT_DEPLOYMENT},${AZURE_OPENAI_EMBEDDING_DEPLOYMENT}",
        "AZURE_OPENAI_AUTH_MODE": "${AZURE_OPENAI_AUTH_MODE}",
        "AZURE_CLIENT_ID": "${AZURE_CLIENT_ID}",
        "AZURE_TENANT_ID": "${AZURE_TENANT_ID}",
        "AZURE_OPENAI_API_KEY": "${AZURE_OPENAI_API_KEY}",
        "AZURE_OPENAI_ALLOW_DEPLOYMENT_MUTATION": "false",
        "AZURE_OPENAI_ALLOW_BILLING_ACCESS": "false",
        "AZURE_OPENAI_ALLOWED_OPERATIONS": "completions,embeddings"
      },
      "enabled": false,
      "status": "construir",
      "notes": "Server custom pendente; restringir aos deployments homologados e bloquear criacao/remocao de deployment, fine-tuning e billing."
    },
    "mcp-azure-devops": {
      "name": "mcp-azure-devops",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp-azure-devops/index.js"
      ],
      "env": {
        "AZDO_ORG_URL": "${AZDO_ORG_URL}",
        "AZDO_PROJECT": "${AZDO_PROJECT}",
        "AZDO_PAT": "${AZDO_PAT}",
        "AZDO_ALLOWED_PROJECTS": "${AZDO_PROJECT}",
        "AZDO_ALLOW_DELETE_WORK_ITEMS": "false",
        "AZDO_ALLOW_PIPELINE_ADMIN": "false",
        "AZDO_ALLOW_PERMISSIONS_ADMIN": "false",
        "AZDO_ALLOWED_OPERATIONS": "list_work_items,create_work_item,update_work_item_status,list_sprints,get_board_view,query_items_by_iteration"
      },
      "enabled": false,
      "status": "validar",
      "notes": "Implementacoes de comunidade exigem validacao de maturidade, cobertura de APIs e autenticacao; escopo apenas no projeto ${AZDO_PROJECT}."
    },
    "mcp-confluence": {
      "name": "mcp-confluence",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@atlassian/mcp-confluence"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "${CONFLUENCE_BASE_URL}",
        "CONFLUENCE_TOKEN": "${CONFLUENCE_TOKEN}",
        "CONFLUENCE_ALLOWED_SPACES": "${CONFLUENCE_ALLOWED_SPACES}",
        "CONFLUENCE_READ_ONLY": "true",
        "CONFLUENCE_ALLOW_WRITE": "false",
        "CONFLUENCE_ALLOWED_OPERATIONS": "search_pages,get_page_content,list_spaces,get_page_children"
      },
      "enabled": false,
      "status": "validar",
      "notes": "Validar suporte real a escopo read-only por espaco; bloquear criacao/edicao/delecao de paginas, comentarios e anexos."
    },
    "mcp-filesystem": {
      "name": "mcp-filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./src",
        "./specs",
        "./skills",
        "./docs",
        "./prompts",
        "./tests",
        "./data/retrieval-corpus"
      ],
      "env": {
        "FILESYSTEM_BLOCKED_PATTERNS": ".env,.env.*,./infra,./node_modules,./secrets,*.key,*.pem,*.pfx",
        "FILESYSTEM_READONLY_PATHS": "./data/retrieval-corpus",
        "FILESYSTEM_ALLOW_DELETE": "false",
        "FILESYSTEM_ALLOW_EXEC": "false"
      },
      "enabled": true,
      "status": "publico",
      "notes": "Allowlist explicita em args; tudo fora da lista fica inacessivel por padrao; manter corpus de retrieval em modo somente leitura por politica do cliente e ACL local."
    },
    "mcp-git": {
      "name": "mcp-git",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {
        "MCP_GIT_READ_ONLY": "true",
        "MCP_GIT_ALLOWED_OPERATIONS": "git_log,git_diff,git_status,git_show,git_branch,git_blame",
        "MCP_GIT_BLOCKED_OPERATIONS": "git_commit,git_push,git_merge,git_rebase,git_reset,git_tag"
      },
      "enabled": true,
      "status": "publico",
      "notes": "Uso estritamente de leitura do historico Git no repositorio local; operacoes de escrita no historico devem ficar bloqueadas por politica."
    },
    "mcp-memory": {
      "name": "mcp-memory",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_NAMESPACE": "novatech-assistant",
        "MEMORY_STORAGE_PATH": "${MEMORY_STORAGE_PATH}",
        "MEMORY_ALLOW_DELETE": "false",
        "MEMORY_ALLOWED_ENTITY_TYPES": "ubiquitous_language,architectural_decision,pattern,anti_pattern"
      },
      "enabled": true,
      "status": "publico",
      "notes": "Namespace isolado por projeto; nao armazenar credenciais, tokens ou PII; delete restrito por politica para papeis autorizados."
    }
  }
}
